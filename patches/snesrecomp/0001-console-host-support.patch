diff --git a/tests/host/host_clock_test.c b/tests/host/host_clock_test.c
index 24ac636..a4456ac 100644
--- a/tests/host/host_clock_test.c
+++ b/tests/host/host_clock_test.c
@@ -72,6 +72,27 @@ int main(void) {
   }
   assert(pal.simulation_frames >= 50 && pal.simulation_frames <= 51); /* 1.0 vs 50 x 0.02 in floating point */
 
+#if defined(SRPS4)
+  /* Console (vsync on a 59.94 Hz display, ~11 ms of work per frame): a late
+   * frame must not gate the next one a full period after its own end, or the
+   * next start lands ~11 ms past the vblank and misses the following one. */
+  SnesHostClock vsync;
+  snes_host_clock_reset(&vsync, 0, sim, 60);
+  const double vblank = 1 / 59.94, work = 0.011;
+  double t = 0, waited = 0;
+  for (int f = 0; f < 600; ++f) {
+    if (!snes_host_clock_simulation_due(&vsync, t)) {
+      waited += vsync.next_simulation - t;
+      t = vsync.next_simulation;
+    }
+    double done = t + work;
+    snes_host_clock_simulation_done(&vsync, done, false, 1);
+    t = ceil(done / vblank) * vblank;   /* present blocks to the next vblank */
+  }
+  assert(fabs(t - 600 * vblank) < 1e-6);   /* one vblank per frame, no misses */
+  assert(waited < 0.001);
+#endif
+
   /* Presentation-rate policy: an explicit supported fps wins, otherwise the
    * display's refresh, clamped; garbage falls back to 60. */
   assert(snes_host_valid_fps(0) && snes_host_valid_fps(144) && !snes_host_valid_fps(100));
