 static void thread_join(WorkerThread t) { pthread_join(t, NULL); }
+#if defined(SRPS4) && SRPS4_CONSOLE
+/* snesrecomp-ps4: libkernel's sysconf() follows FreeBSD's _SC_* numbering, not
+ * musl's, so the query fails. A game process owns six of the eight Jaguar
+ * cores; the caller plus up to three workers stays inside that budget. */
+static unsigned available_cpus(void) { return 6; }
+#else
 static unsigned available_cpus(void) { long n = sysconf(_SC_NPROCESSORS_ONLN); return n > 0 ? (unsigned)n : 1; }
+#endif
 #define WORKER_ENTRY void *
 #define WORKER_RETURN NULL
 #endif
 
+/* snesrecomp-ps4: pinning + per-slot diagnostics.
+ * The PS4 scheduler (FreeBSD ULE) tends to wake a sleeping thread near the
+ * CPU that woke it. These workers sleep between frames and run for a few ms
+ * per frame, so unpinned they can pile onto the main thread's core and the
+ * "parallel" compose serializes. On the console worker k is pinned to core
+ * k (1-4), inside the six cores a game process owns; the main thread (core
+ * 0) and the compose thread (core 5) pin themselves. */
+#if defined(SRPS4) && SRPS4_CONSOLE
+int scePthreadSetaffinity(pthread_t thread, unsigned long mask);
+pthread_t scePthreadSelf(void);
+int sceKernelGetCurrentCpu(void);
+/* SNESRECOMP_RENDER_PIN=0 disables pinning (A/B from srps4_env.txt). */
+static bool pinning_enabled(void) {
+  const char *v = getenv("SNESRECOMP_RENDER_PIN");
+  return !(v && *v == '0');
+}
+static void pin_current_thread(unsigned core) {
+  if (pinning_enabled()) scePthreadSetaffinity(scePthreadSelf(), 1ul << core);
+}
+static int current_cpu(void) { return sceKernelGetCurrentCpu(); }
+#else
+static void pin_current_thread(unsigned core) { (void)core; }
+static int current_cpu(void) { return -1; }
+#endif
+#ifdef _WIN32
+static double worker_now(void) { return 0; }
+#else
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+static double worker_now(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+#endif
+
 #ifdef _MSC_VER
 #define WORKER_LOCAL __declspec(thread)
 #else
