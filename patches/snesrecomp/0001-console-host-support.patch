diff --git a/runner/src/host_paths.c b/runner/src/host_paths.c
index 216a8ff..bc67835 100644
--- a/runner/src/host_paths.c
+++ b/runner/src/host_paths.c
@@ -29,8 +29,17 @@
 /* Full path of the running executable. Returns 1 on success. Platforms
  * without a query mechanism (e.g. Switch homebrew) return 0 and callers
  * fall back to cwd-relative behavior. */
+#if defined(SRPS4)
+const char *srps4_data_dir(void);
+#endif
+
 static int get_exe_path(char *out, size_t max_len) {
-#if defined(_WIN32)
+#if defined(SRPS4)
+    /* snesrecomp-ps4: the package mount is read-only; the port's writable
+     * per-title data directory stands in for "beside the executable". */
+    int n = snprintf(out, max_len, "%s/eboot.bin", srps4_data_dir());
+    return (n > 0 && (size_t)n < max_len) ? 1 : 0;
+#elif defined(_WIN32)
     DWORD n = GetModuleFileNameA(NULL, out, (DWORD)max_len);
     return (n > 0 && n < max_len) ? 1 : 0;
 #elif defined(__APPLE__)
diff --git a/runner/src/render_workers.c b/runner/src/render_workers.c
index bd34fbf..87887cc 100644
--- a/runner/src/render_workers.c
+++ b/runner/src/render_workers.c
@@ -36,7 +36,14 @@ static void condition_wake(WorkerCondition *c) { pthread_cond_signal(c); }
 static void condition_wake_all(WorkerCondition *c) { pthread_cond_broadcast(c); }
 static void condition_destroy(WorkerCondition *c) { pthread_cond_destroy(c); }
 static void thread_join(WorkerThread t) { pthread_join(t, NULL); }
+#if defined(SRPS4) && SRPS4_CONSOLE
+/* snesrecomp-ps4: libkernel's sysconf() follows FreeBSD's _SC_* numbering, not
+ * musl's, so the query fails. A game process owns six of the eight Jaguar
+ * cores; the caller plus up to three workers stays inside that budget. */
+static unsigned available_cpus(void) { return 6; }
+#else
 static unsigned available_cpus(void) { long n = sysconf(_SC_NPROCESSORS_ONLN); return n > 0 ? (unsigned)n : 1; }
+#endif
 #define WORKER_ENTRY void *
 #define WORKER_RETURN NULL
 #endif
