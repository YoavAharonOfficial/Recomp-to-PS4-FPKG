diff --git a/runner/src/desktop/host_clock.c b/runner/src/desktop/host_clock.c
index c2a9529..2aa8e9e 100644
--- a/runner/src/desktop/host_clock.c
+++ b/runner/src/desktop/host_clock.c
@@ -24,8 +24,24 @@ void snes_host_clock_simulation_done(SnesHostClock *c, double now,
   /* Keep ordinary sub-frame scheduling jitter on the original phase. A
    * loader may preserve its backlog so its non-interactive frames refill the
    * guest-driven audio queue; all ordinary gameplay drops stale work. */
+#if defined(SRPS4)
+  /* A late frame drops its debt but may start the next one at once. Gating
+   * it a full period after this frame's END (below) is harmless while the
+   * frame costs a sliver of the period, as on a desktop. On the console a
+   * frame costs ~2/3 of it: the extra gate pushed the next start ~11 ms past
+   * the vblank the present just waited for, that frame missed its own vblank,
+   * and the miss made the next one late too. The display's 59.94 Hz versus
+   * the SNES's 60.10 Hz makes every frame "late" by a hair, so with vsync on
+   * this cascade fired every few frames (console profile: deadline-wait on
+   * 19% of frames, ~52 fps with ~11 ms of work per frame). The gate is the
+   * instant just after `now`, so a caller that loops while due at one frozen
+   * `now` still runs exactly one frame. */
+  c->next_simulation = preserve_debt || now <= deadline
+      ? deadline : nextafter(now, INFINITY);
+#else
   c->next_simulation = preserve_debt || now <= deadline
       ? deadline : now + 1.0 / c->simulation_hz;
+#endif
   ++c->simulation_frames;
 }
 
