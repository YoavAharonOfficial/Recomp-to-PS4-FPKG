diff --git a/src/video/ps4/SDL_ps4piglet.c b/src/video/ps4/SDL_ps4piglet.c
index 17016e3c..9e0392e5 100644
--- a/src/video/ps4/SDL_ps4piglet.c
+++ b/src/video/ps4/SDL_ps4piglet.c
@@ -178,13 +178,21 @@ int PS4_PigletInit() {
 
     SDL_memset(&ps4_pgl_config, 0, sizeof(ps4_pgl_config));
     ps4_pgl_config.size = sizeof(ps4_pgl_config);
-    ps4_pgl_config.flags = 0;
-    ps4_pgl_config.systemSharedMemorySize = 256 * 1024 * 1024;
+    /* Piglet's shared memory must come from the app's own flexible memory:
+     * with flags = 0 it is taken from the *system* flexible pool, which a
+     * game-type fpkg cannot map on newer firmware, and eglGetDisplay() then
+     * returns EGL_NO_DISPLAY. Same flags as the OpenOrbis Piglet sample and
+     * PacBrew's own earlier "fix piglet init (low gpu/sys ram)" commit. A
+     * modest system share keeps clear of the app's flexible-memory budget. */
+    ps4_pgl_config.flags = ORBIS_PGL_FLAGS_USE_COMPOSITE_EXT | ORBIS_PGL_FLAGS_USE_FLEXIBLE_MEMORY;
+    ps4_pgl_config.systemSharedMemorySize = 128 * 1024 * 1024;
     ps4_pgl_config.videoSharedMemorySize = 256 * 1024 * 1024;
     ps4_pgl_config.drawCommandBufferSize = 1 * 1024 * 1024;
     ps4_pgl_config.lcueResourceBufferSize = 1 * 1024 * 1024;
     ps4_pgl_config.dbgPosCmd_0x40 = 1920;
     ps4_pgl_config.dbgPosCmd_0x44 = 1080;
+    ps4_pgl_config.dbgPosCmd_0x48 = 0;
+    ps4_pgl_config.dbgPosCmd_0x4C = 0;
     ps4_pgl_config.unk_0x5C = 2;
 
     if (!scePigletSetConfigurationVSH(&ps4_pgl_config)) {
@@ -192,7 +200,10 @@ int PS4_PigletInit() {
         return 1;
     }
 
-    SDL_Log("PS4_PigletInit: Ok\n");
+    SDL_Log("PS4_PigletInit: Ok (flags=0x%x sys=%u MiB video=%u MiB)\n",
+            (unsigned) ps4_pgl_config.flags,
+            (unsigned) (ps4_pgl_config.systemSharedMemorySize >> 20),
+            (unsigned) (ps4_pgl_config.videoSharedMemorySize >> 20));
 
     return 0;
 }
diff --git a/src/video/ps4/SDL_ps4video.c b/src/video/ps4/SDL_ps4video.c
index 47b93aa8..7f7eb6a3 100644
--- a/src/video/ps4/SDL_ps4video.c
+++ b/src/video/ps4/SDL_ps4video.c
@@ -20,6 +20,7 @@
 */
 
 #include "../../SDL_internal.h"
+#include <stdio.h>
 
 #if SDL_VIDEO_DRIVER_PS4
 
@@ -51,7 +52,10 @@ char log_buffer[1024];
 static void *
 PS4_logCb(void *userdata, int category, SDL_LogPriority priority, const char *message) {
     snprintf(log_buffer, 1023, "<SDL2> %s\n", message);
-    sceKernelDebugOutText(0, log_buffer);
+    /* stdio, not sceKernelDebugOutText directly: the host captures stderr
+     * into its log file and mirrors it to klog, so SDL's PS4 bring-up
+     * messages land in both places. */
+    fputs(log_buffer, stderr);
     return NULL;
 }
 
