@@ -191,6 +243,14 @@ int audio_init(int psg_sample_rate)
      * pitch-preserving loop of recent audio instead of fading to silence. */
     cfg.preroll_ms     = 200.0;
     cfg.stretch_enable = 1;     /* conceal on (defaults to 1; pinned explicit) */
+#if defined(SRPS4) && SRPS4_CONSOLE
+    /* snesrecomp-ps4: a 200 ms boot cushion drains at the servo's 0.5% limit,
+     * so audio trailed the picture by ~0.2 s for half a minute. Prime and hold
+     * a smaller queue (SRPS4_AUDIO_TARGET_MS, default 40; preroll follows it). */
+    { const char *e = getenv("SRPS4_AUDIO_TARGET_MS"); double v = e && *e ? atof(e) : 40.0;
+      if (v < 20.0) v = 20.0; else if (v > 150.0) v = 150.0;
+      cfg.target_ms = v; cfg.preroll_ms = v; }
+#endif
     if (rab_init(&s_bridge, &cfg) != 0) {
         fprintf(stderr, "audio: rab_init (DRC bridge) failed\n");
         SDL_CloseAudioDevice(s_dev); s_dev = 0;
@@ -208,8 +268,8 @@ int audio_init(int psg_sample_rate)
      * reaches the pre-roll fill, then fades in (clean startup, no edge click). */
     SDL_PauseAudioDevice(s_dev, 0);
     fprintf(stderr, "[audio] DRC bridge: %d Hz internal -> %d Hz device "
-            "(preroll %.0f ms, conceal %s)\n",
-            psg_sample_rate, got.freq, cfg.preroll_ms,
+            "(preroll %.0f ms, target %.0f ms, %u-sample device buffer, conceal %s)\n",
+            psg_sample_rate, got.freq, cfg.preroll_ms, cfg.target_ms, (unsigned)got.samples,
             cfg.stretch_enable ? "on" : "off");
     return 0;
 }
