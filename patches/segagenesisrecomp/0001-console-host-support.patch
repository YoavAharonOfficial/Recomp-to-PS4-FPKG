 /* Shared clock-domain bridge: persistent band-limited polyphase resampler + a
  * P-only normalized-fill controller, plus Phase-1 stall concealment (boot
@@ -57,10 +59,54 @@ static uint64_t s_trace_final_fill_us;
 static void genesis_audio_callback(void *user, Uint8 *stream, int len)
 {
     (void)user;
+#if defined(SRPS4) && SRPS4_CONSOLE
+    { static int s_first = 1;
+      if (s_first) {
+        /* The main thread is pinned to core 0 before SDL starts, and FreeBSD
+         * threads inherit their creator's cpuset: SDL's audio thread would
+         * share core 0 with ~13 ms of emulation per frame and miss its
+         * deadlines (crackle). Give it core 1. */
+        extern unsigned long srps4_current_affinity(void);
+        extern void srps4_pin_current_thread(unsigned core);
+        unsigned long before = srps4_current_affinity();
+        srps4_pin_current_thread(1);
+        s_first = 0;
+        fprintf(stderr, "[srps4-boot] audio: first callback, %d bytes, bridge %s; thread cores 0x%lx -> 0x%lx\n",
+                len, s_bridge_ready ? "ready" : "not ready", before, srps4_current_affinity()); } }
+#endif
     if (!s_bridge_ready) { memset(stream, 0, (size_t)len); return; }
     int frames = len / (int)(2 * sizeof(int16_t)); /* stereo S16 */
     Uint64 begin = SDL_GetPerformanceCounter();
     rab_pull(&s_bridge, (int16_t *)stream, frames);
+#if defined(SRPS4) && SRPS4_CONSOLE
+    {   /* snesrecomp-ps4: makeup gain with a soft limiter. The native mix peaks
+         * near -7 dBFS with about -26 dBFS RMS in play, roughly 8-10 dB under
+         * mastered soundtrack releases, so it sounds thin on a TV/AV system.
+         * Gain is SRPS4_AUDIO_GAIN_DB (default +6, 0 = off); above -3 dBFS
+         * the curve bends smoothly into full scale instead of clipping. */
+        static float s_gain = -1.0f;
+        if (s_gain < 0.0f) {
+            const char *g = getenv("SRPS4_AUDIO_GAIN_DB");
+            float db = g && *g ? (float)atof(g) : 6.0f;
+            if (db < 0.0f) db = 0.0f; else if (db > 18.0f) db = 18.0f;
+            s_gain = powf(10.0f, db / 20.0f);
+        }
+        if (s_gain > 1.0f) {
+            int16_t *pcm = (int16_t *)stream;
+            const float knee = 0.7079f;           /* -3 dBFS */
+            for (int i = 0; i < frames * 2; ++i) {
+                float x = pcm[i] * (s_gain / 32768.0f), m = fabsf(x);
+                if (m > knee) {
+                    float over = (m - knee) / (1.0f - knee);
+                    m = knee + (1.0f - knee) * tanhf(over);
+                    x = x < 0 ? -m : m;
+                }
+                int v = (int)lrintf(x * 32767.0f);
+                pcm[i] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+            }
+        }
+    }
+#endif
     uint32_t elapsed = (uint32_t)((SDL_GetPerformanceCounter() - begin)
                                 * 1000000ull / s_perf_freq);
     if (elapsed > s_callback_peak_us) s_callback_peak_us = elapsed;
@@ -166,6 +212,12 @@ int audio_init(int psg_sample_rate)
     want.format   = AUDIO_S16SYS;
     want.channels = 2;
     want.samples  = 1024;
+#if defined(SRPS4) && SRPS4_CONSOLE
+    /* snesrecomp-ps4: the audio thread has its own core on the console, so
+     * the device buffer can shrink (SRPS4_AUDIO_SAMPLES, default 512). */
+    { const char *e = getenv("SRPS4_AUDIO_SAMPLES"); int v = e && *e ? atoi(e) : 512;
