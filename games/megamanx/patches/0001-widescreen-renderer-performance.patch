+#if defined(SRPS4)
+/* ---- Pipelined compose (snesrecomp-ps4) ---------------------------------
+ * The widescreen compose of frame N runs on its own thread while the main
+ * thread emulates and captures frame N+1. Per-frame cost becomes roughly
+ * max(guest + capture, compose) instead of their sum, for one frame of
+ * added latency.
+ *
+ * Main thread, at the end of each capture (MmxRendererPipelineSubmit):
+ *   wait for the compose thread to go idle, copy world 0 (capture) into
+ *   world 1 (compose snapshot), post the job. Main thread, at present
+ *   (MmxRendererPipelineLatest): use the newest completed composition;
+ *   when nothing new was captured since the last present (pause, menus,
+ *   thumbnails), wait for the in-flight one so the newest frame shows.
+ *
+ * Correctness rests on the compose side reading only world 1 plus its own
+ * scratch; see the RenderWorld notes at the top of this file. */
+#include <pthread.h>
+#include <stdlib.h>
+#include <stddef.h>
+#if SRPS4_CONSOLE
+int scePthreadSetaffinity(pthread_t thread, unsigned long mask);
+pthread_t scePthreadSelf(void);
+#endif
+
+enum { PIPE_SLOTS = 2 };
+static struct {
+  bool started, failed;
+  pthread_t thread;
+  pthread_mutex_t lock;
+  pthread_cond_t job_ready, job_done;
+  bool busy;                 /* a job is posted or running */
+  unsigned generation;       /* bumped on every submit */
+  /* Job inputs (copied at submit). */
+  MmxRenderView view; bool hud, valid;
+  unsigned slot;             /* output slot the job writes */
+  /* Results. */
+  uint32_t out[PIPE_SLOTS][MMX_RENDER_MAX_WIDTH * 224];
+  int width[PIPE_SLOTS];
+  int completed;             /* slot of the newest completed composition, -1 none */
+  int previous;              /* at submit: the composition it supersedes (N-1) */
+  bool fresh;                /* a submit happened since the last present */
+  uint32_t fallback_field[256 * 224];
+} pipe = {.completed = -1, .previous = -1};
+
+/* copy_world names RenderWorld members directly: suspend the per-thread
+ * aliases for its body. */
+#pragma push_macro("frame")
+#pragma push_macro("line_vram_idx")
+#undef frame
+#undef line_vram_idx
+static void copy_world(RenderWorld *dst, const RenderWorld *src) {
+  const Frame *sf = &src->frame;
+  Frame *df = &dst->frame;
+  for (int i = 0; i < 224; ++i) {
+    const Raster *r = &sf->lines[i];
+    Raster *d = &df->lines[i];
+    memcpy(d->registers, r->registers, sizeof(d->registers));
+    memcpy(d->palette, r->palette, sizeof(d->palette));
+    memcpy(d->oam, r->oam, sizeof(d->oam));
+    memcpy(d->high_oam, r->high_oam, sizeof(d->high_oam));
+    /* Shared lines take their pixels from their owner's copy. */
+    if (!src->line_vram_idx[i]) memcpy(d->vram, r->vram, sizeof(d->vram));
+  }
+  const size_t tail = offsetof(Frame, ram);
+  memcpy((char *)df + tail, (const char *)sf + tail, sizeof(Frame) - tail);
+  const size_t rest = offsetof(RenderWorld, line_vram_idx);
+  memcpy((char *)dst + rest, (const char *)src + rest, sizeof(RenderWorld) - rest);
+}
+#pragma pop_macro("line_vram_idx")
+#pragma pop_macro("frame")
+
+static void pipe_fallback(uint32_t *out, int w) {
+  /* Same as MmxDrawFrame's stock fallback, from the field captured with
+   * this job (the live PPU buffer has moved on by now). */
+  memset(out, 0, (size_t)w * 224 * sizeof(*out));
+  for (int y = 0; y < 224; ++y)
+    memcpy(out + y * w + (w - 256) / 2, pipe.fallback_field + y * 256, 256 * 4);
+}
+
+static void *pipe_main(void *unused) {
+  (void)unused;
+#if SRPS4_CONSOLE
+  /* Core 5: the main thread owns core 0, compose workers cores 1-4. */
+  const char *pin = getenv("SNESRECOMP_RENDER_PIN");
+  if (!(pin && *pin == '0')) scePthreadSetaffinity(scePthreadSelf(), 1ul << 5);
+#endif
+  render_world_tls = &render_worlds[1];
+  pthread_mutex_lock(&pipe.lock);
+  for (;;) {
+    while (!pipe.busy) pthread_cond_wait(&pipe.job_ready, &pipe.lock);
+    MmxRenderView view = pipe.view; bool hud = pipe.hud, valid = pipe.valid;
+    unsigned slot = pipe.slot;
+    pthread_mutex_unlock(&pipe.lock);
+    uint32_t *out = pipe.out[slot];
+    if (!valid || !MmxRendererDraw(out, view, hud)) pipe_fallback(out, view.width);
+    pthread_mutex_lock(&pipe.lock);
+    pipe.width[slot] = view.width;
+    pipe.completed = (int)slot;
+    pipe.busy = false;
+    pthread_cond_broadcast(&pipe.job_done);
+  }
+  return NULL;
+}
+
+bool MmxRendererPipelineEnabled(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *v = getenv("MMX_RENDER_PIPELINE");
+#if SRPS4_CONSOLE
+    enabled = !(v && *v == '0');      /* console: on unless disabled */
+#else
+    enabled = v && *v && *v != '0';   /* native smoke test: opt in */
+#endif
+  }
+  return enabled && !pipe.failed;
+}
+
+static bool pipe_start(void) {
+  if (pipe.started) return !pipe.failed;
+  pipe.started = true;
+  if (pthread_mutex_init(&pipe.lock, NULL) || pthread_cond_init(&pipe.job_ready, NULL) ||
+      pthread_cond_init(&pipe.job_done, NULL) ||
+      pthread_create(&pipe.thread, NULL, pipe_main, NULL)) {
+    pipe.failed = true;
+    fprintf(stderr, "[mmx] pipelined compose unavailable; composing on the main thread\n");
+    return false;
+  }
+  fprintf(stderr, "[mmx] pipelined compose enabled\n");
+  return true;
+}
+
+static void pipe_wait_idle_locked(void) {
+  while (pipe.busy) pthread_cond_wait(&pipe.job_done, &pipe.lock);
+}
