+/* Per-line VRAM sharing. SNES VRAM is only writable in vblank or forced
+ * blank, so within the visible frame consecutive lines almost always see
+ * identical VRAM. Copying all 64 KiB into every Raster cost 14.7 MB of
+ * memcpy per frame and left compose streaming a 14.7 MB working set; on the
+ * PS4's Jaguar that made raster capture and compose memory-bound. A line now
+ * takes its own copy only when VRAM differs from the last copied line, and
+ * otherwise points at that copy. The comparison is exact, so it holds no
+ * matter which path wrote VRAM. Raster's layout (and the capture file format)
+ * is unchanged: the sharing is a side table (line_vram_idx in RenderWorld). */
+typedef uint64_t mmx_u64_unaligned __attribute__((aligned(1), may_alias));
+static bool vram_equal(const uint16_t *a, const uint16_t *b) {
+  const mmx_u64_unaligned *x = (const mmx_u64_unaligned *)a;
+  const mmx_u64_unaligned *y = (const mmx_u64_unaligned *)b;
+  enum { kWords = 0x8000 * sizeof(uint16_t) / sizeof(uint64_t) };
+  for (unsigned i = 0; i < kWords; i += 8) {
+    uint64_t d = (x[i] ^ y[i]) | (x[i + 1] ^ y[i + 1]) | (x[i + 2] ^ y[i + 2]) |
+                 (x[i + 3] ^ y[i + 3]) | (x[i + 4] ^ y[i + 4]) | (x[i + 5] ^ y[i + 5]) |
+                 (x[i + 6] ^ y[i + 6]) | (x[i + 7] ^ y[i + 7]);
+    if (d) return false;
+  }
+  return true;
