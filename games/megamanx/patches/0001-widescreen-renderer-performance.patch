+void MmxRendererPipelineSubmit(MmxRenderView view, bool hud, bool valid,
+                               const uint32_t *field) {
+  if (!pipe_start()) return;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  /* The compose thread is idle: world 1 and the fallback field are free. */
+  copy_world(&render_worlds[1], &render_worlds[0]);
+  if (field) memcpy(pipe.fallback_field, field, sizeof(pipe.fallback_field));
+  else memset(pipe.fallback_field, 0, sizeof(pipe.fallback_field));
+  pipe.view = view; pipe.hud = hud; pipe.valid = valid;
+  /* Frame N-1 is complete (the thread is idle): it is what the next present
+   * shows, whatever the new job's timing. Write the job into the other slot
+   * so that present never races the compose thread. */
+  pipe.previous = pipe.completed;
+  pipe.slot = pipe.previous == 0 ? 1u : 0u;
+  pipe.busy = true;
+  ++pipe.generation;
+  pipe.fresh = true;
+  pthread_cond_signal(&pipe.job_ready);
+  pthread_mutex_unlock(&pipe.lock);
+}
+
+const uint32_t *MmxRendererPipelineLatest(int *width) {
+  if (!pipe.started || pipe.failed) return NULL;
+  pthread_mutex_lock(&pipe.lock);
+  /* A present right after a submit shows exactly frame N-1 -- never "the
+   * newest that happens to be done", which would alternate between N-1 and
+   * N with compose timing and judder. With nothing captured since the last
+   * present (pause, menus, thumbnails), or before any earlier composition
+   * exists, wait for the in-flight frame and show it. */
+  int slot;
+  if (pipe.fresh && pipe.previous >= 0) {
+    slot = pipe.previous;
+  } else {
+    pipe_wait_idle_locked();
+    slot = pipe.completed;
+  }
+  pipe.fresh = false;
+  const uint32_t *out = slot >= 0 ? pipe.out[slot] : NULL;
+  if (out && width) *width = pipe.width[slot];
+  pthread_mutex_unlock(&pipe.lock);
+  return out;
+}
+
+/* The custom renderer is off this frame: drop the remembered compositions so
+ * that turning it back on never shows a frame from before. */
+void MmxRendererPipelineForget(void) {
+  if (!pipe.started || pipe.failed) return;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  pipe.completed = pipe.previous = -1;
+  pipe.fresh = false;
+  pthread_mutex_unlock(&pipe.lock);
+}
+
+void MmxRendererPipelineDrain(void) {
+  if (!pipe.started || pipe.failed) return;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  pthread_mutex_unlock(&pipe.lock);
+}
+#endif
