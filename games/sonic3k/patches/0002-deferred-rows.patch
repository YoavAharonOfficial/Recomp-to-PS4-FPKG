 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <stddef.h>
+#include <pthread.h>
+#include <stdatomic.h>
+/* Deferred row rendering (rows_try_defer). A row job runs after its raster
+ * time, possibly on a worker thread, while other rows run concurrently.
+ *  - ROWS_SERIAL: code that keeps static scratch runs under one lock.
+ *  - ROWS_ONCE(flag) { decode } : a lazily decoded cache. The first caller
+ *    decodes under a lock and `flag` is published (release) only when the
+ *    block exits, so a concurrent row never reads a half-decoded cache.
+ *    Outside a job it is the original "if(!flag){flag=1;...}". */
+static _Thread_local int s_rows_in_job,s_rows_lazy_depth;
+static pthread_mutex_t s_rows_serial=PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t s_rows_lazy=PTHREAD_MUTEX_INITIALIZER;
+#define ROWS_SERIAL(stmt) do { if(s_rows_in_job){pthread_mutex_lock(&s_rows_serial);stmt;pthread_mutex_unlock(&s_rows_serial);} \
+                               else {stmt;} } while(0)
+typedef struct { int *flag;int locked,run; } RowsOnce;
+static RowsOnce rows_once_enter(int *flag)
+{
+    RowsOnce o={NULL,0,0};
+    if(__atomic_load_n(flag,__ATOMIC_ACQUIRE))return o;
+    if(s_rows_in_job && s_rows_lazy_depth++==0){pthread_mutex_lock(&s_rows_lazy);}
+    o.locked=s_rows_in_job;
+    if(!__atomic_load_n(flag,__ATOMIC_ACQUIRE)){o.flag=flag;o.run=1;}
+    return o;
+}
+static void rows_once_exit(RowsOnce *o)
+{
+    if(o->flag)__atomic_store_n(o->flag,1,__ATOMIC_RELEASE);
+    if(o->locked && --s_rows_lazy_depth==0)pthread_mutex_unlock(&s_rows_lazy);
+}
+#define ROWS_ONCE(flag) for(RowsOnce rows_once __attribute__((cleanup(rows_once_exit)))=rows_once_enter(&(flag)); \
+                            rows_once.run;rows_once.run=0)
