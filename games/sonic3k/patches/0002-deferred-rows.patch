+/* ---- Deferred row rendering --------------------------------------------------
+ * A level frame's rows depend on the per-frame snapshots taken at row 0
+ * (s_video_frame, s_world_frame, s_background_frame, the selected s_display)
+ * plus each row's live CRAM/VSRAM; nothing else live is consulted on the
+ * level path, which never needs the native-row fallback. So rows 1..223 of
+ * such frames can be recorded at their raster time and drawn later, in
+ * parallel, before anything reads the frame (genesis_video_flush_deferred, called at
+ * the end of each emulated frame and before the next row 0 replaces the
+ * snapshots). The HUD digit extensions read live VRAM/RAM: they are drawn at
+ * raster time into a transparent overlay and composited afterwards, as are
+ * the adapter's overlay_scanline pixels. Output is identical to drawing each
+ * row at its raster time (verified with per-frame framebuffer hashes).
+ * GENESIS_S3_ROW_WORKERS=N selects N worker threads (0 = off). */
+enum { ROWS_MAX_W = 1024, ROWS_MAX_THREADS = 8 };
+typedef struct {
+    int line,nw,width,has_hud,post_used;
+    uint32_t *out;
+    uint16_t cram[sizeof ((GVDP*)0)->cram/2];
+    uint16_t vsram[sizeof ((GVDP*)0)->vsram/2];
+    uint8_t reg[sizeof ((GVDP*)0)->reg];
+    uint32_t hud[ROWS_MAX_W],post[ROWS_MAX_W];
+} RowJob;
+static RowJob s_row_jobs[224];
+static int s_row_count,s_rows_workers=-1,s_rows_threads;
+static unsigned short s_row_index[224];
+static pthread_mutex_t s_rows_mutex=PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_rows_cond=PTHREAD_COND_INITIALIZER;
+static unsigned s_rows_gen;
+static int s_rows_total;
+static unsigned s_rows_frame;
+/* (generation << 32) | next job. A worker claims a job only for the batch
+ * it was woken for, so one that is late or preempted can never take a job
+ * of a later batch, and the caller waits only for jobs actually claimed. */
+static _Atomic uint64_t s_rows_ticket;
+static atomic_int s_rows_done;
+static GVDP s_rows_main_vdp;
+
+static void rows_config(void)
+{
+    const char *e=getenv("GENESIS_S3_ROW_WORKERS");
+#if defined(SRPS4) && SRPS4_CONSOLE
+    int n=4;   /* cores 2-5; emulation keeps core 0, audio core 1 */
