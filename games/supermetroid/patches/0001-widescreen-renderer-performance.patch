+/* ---- Per-pixel composition (snesrecomp-ps4) -----------------------------
+ * The sprite pass of each row is order-dependent and stays serial. Per-pixel
+ * composition reads only the row's recorded state below (register snapshot
+ * after scroll interpolation, background lines, objects, Mode 7 samples) and
+ * writes only that row of `out`, so rows run on snesrecomp's render worker
+ * pool. The pixel code is the former inline loop, unchanged. */
+typedef struct SmRowJob {
+  uint8_t registers[PPU_SAVESTATE_REGS_SIZE];
+  const uint16_t *palette, *vram;
+  SmBackgroundLine background[3];
+  uint8_t brightness[32];
+  const uint8_t *mode7;
+  const uint16_t *objects;
+  SmWideWindow wide;
+  SmMode7Line transform;
+  int mode, mode7_size, y, width, extra;
+} SmRowJob;
+static SmRowJob row_jobs[224];
+static bool row_jobs_active[224];
+static void compose_row_pixels(const SmRowJob *j, Ppu *p, uint32_t *out) {
+  memcpy(p, j->registers, PPU_SAVESTATE_REGS_SIZE);
+    for (int sx = 0; sx < j->width; ++sx) {
+      int x = sx - j->extra;
+      uint16_t screens[2] = {0x500, 0x500};
+      uint16_t backgrounds[3] = {0, 0, 0};
+      int layers = j->mode == 7 ? ((p->setini & 64) ? 2 : 1) : 3;
+      unsigned enabled = p->screenEnabled[0] | p->screenEnabled[1];
+      /* Tile addressing/decoding is identical on main and sub. Cache it
+       * before applying each screen's independent layer/window enables. */
+      for (int layer = 0; layer < layers; ++layer) {
+        if (!(enabled & (1u << layer))) continue;
+        if (j->mode == 7) {
+          unsigned index = j->mode7[sx];
+          if ((p->mosaic & (1u << layer)) && j->mode7_size > 1) {
+            int mx = x - ((x % j->mode7_size) + j->mode7_size) % j->mode7_size;
+            index = SmMode7Sample(&j->transform, j->vram, mx);
+          }
+          unsigned priority = 5;
+          if (layer == 1) {
+            priority = index & 128 ? 9 : 1;
+            index &= 127;
+          }
+          backgrounds[layer] = index ? (priority << 12) | (layer << 8) | index : 0;
+        } else {
+          int sample_x = x, sample_y = j->y + 1;
+          if (p->mosaic & (1u << layer)) {
+            int size = (p->mosaic >> 4) + 1;
+            /* Mosaic precedes scroll and tile lookup, independently per BG.
+             * Floor division extends the native X=0 grid into negative X;
+             * C's truncating remainder would shift blocks in the left margin. */
+            sample_x -= ((sample_x % size) + size) % size;
+            sample_y -= sample_y % size;
+          }
+          bool margin = sample_x < 0 || sample_x >= 256;
+          backgrounds[layer] = background_pixel(&j->background[layer], j->vram,
+                                                 sample_x, sample_y, margin);
+        }
+      }
+      for (int sub = 0; sub < 2; ++sub) {
+        for (int layer = 0; layer < layers; ++layer) {
+          if (!(p->screenEnabled[sub] & (1u << layer))) continue;
+          if ((p->screenWindowed[sub] & (1u << layer)) &&
+              in_window(p, layer, x, j->extra, &j->wide)) continue;
+          if (backgrounds[layer] > screens[sub]) screens[sub] = backgrounds[layer];
+        }
+        if ((p->screenEnabled[sub] & 16) &&
+            (!(p->screenWindowed[sub] & 16) ||
+             !in_window(p, 4, x, j->extra, &j->wide)) &&
+            j->objects[sx] > screens[sub]) screens[sub] = j->objects[sx];
+      }
+      out[sx] = colour(p, j->palette, j->brightness, screens[0], screens[1],
+                                            in_window(p, 5, x, j->extra, &j->wide));
+    }
