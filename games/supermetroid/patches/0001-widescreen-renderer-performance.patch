+#if defined(SRPS4)
+/* ---- Pipelined compose (snesrecomp-ps4) ---------------------------------
+ * The widescreen compose of frame N runs on its own thread while the main
+ * thread emulates and captures frame N+1; a present shows exactly frame N-1.
+ * Per-frame cost on the main thread becomes guest + capture, for one frame
+ * of added latency (same design as the Mega Man X port).
+ *
+ * Safety: capture writes only slot `current` of frames[] (plus its own
+ * latch/owner bookkeeping); the compose of slot k reads slots k and k-1 and
+ * otherwise only draw-side statics. Submit waits for the compose thread to go
+ * idle before posting, so capture of N+1 (slot k+1) can never overlap a draw
+ * that reads it, and slot k+2 == k-1 is reused only after compose(k) ended.
+ * Interpolated presentation (alpha < 1) is a desktop feature; the console
+ * presents in lockstep, so a pipelined draw always uses alpha = 1. */
+#include <pthread.h>
+void srps4_pin_current_thread(unsigned core);
+static struct {
+  bool started, failed, busy, fresh;
+  pthread_t thread;
+  pthread_mutex_t lock;
+  pthread_cond_t job_ready, job_done;
+  unsigned slot_in;            /* frames[] slot to draw */
+  SmViewport viewport; bool hud;
+  unsigned out_slot;
+  uint32_t out[2][SM_MAX_WIDTH * SM_HEIGHT];
+  int width[2];
+  int completed, previous;
+  uint32_t field[256 * 224];
+  int profile;
+  unsigned stat_jobs;
+  double stat_compose, stat_compose_max, stat_wait, stat_wait_max;
+} pipe = {.completed = -1, .previous = -1, .profile = -1};
+
+static void *pipe_main(void *unused) {
+  (void)unused;
+  const char *pin = getenv("SNESRECOMP_RENDER_PIN");
+  if (!(pin && *pin == '0')) srps4_pin_current_thread(5);
+  pthread_mutex_lock(&pipe.lock);
+  for (;;) {
+    while (!pipe.busy) pthread_cond_wait(&pipe.job_ready, &pipe.lock);
+    unsigned slot = pipe.slot_in, out_slot = pipe.out_slot;
+    SmViewport vp = pipe.viewport; bool hud = pipe.hud;
+    pthread_mutex_unlock(&pipe.lock);
+    double t0 = pipe.profile ? sm_now() : 0;
+    uint32_t *out = pipe.out[out_slot];
+    if (!draw_slot(slot, out, vp, hud, 1.0)) {
+      memset(out, 0, (size_t)vp.width * SM_HEIGHT * sizeof(*out));
+      for (int y = 0; y < SM_HEIGHT; ++y)
+        memcpy(out + y * vp.width + vp.extra, pipe.field + y * 256, 256 * 4);
+    }
+    double took = pipe.profile ? sm_now() - t0 : 0;
+    pthread_mutex_lock(&pipe.lock);
+    pipe.stat_compose += took;
+    if (took > pipe.stat_compose_max) pipe.stat_compose_max = took;
+    pipe.width[out_slot] = vp.width;
+    pipe.completed = (int)out_slot;
+    pipe.busy = false;
+    pthread_cond_broadcast(&pipe.job_done);
+  }
+  return NULL;
+}
+bool SmRendererPipelineEnabled(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *v = getenv("SM_RENDER_PIPELINE");
+#if SRPS4_CONSOLE
+    enabled = !(v && *v == '0');
+#else
+    enabled = v && *v && *v != '0';
+#endif
+  }
+  return enabled && !pipe.failed;
+}
+static bool pipe_start(void) {
+  if (pipe.started) return !pipe.failed;
+  pipe.started = true;
+  if (pthread_mutex_init(&pipe.lock, NULL) || pthread_cond_init(&pipe.job_ready, NULL) ||
+      pthread_cond_init(&pipe.job_done, NULL) ||
+      pthread_create(&pipe.thread, NULL, pipe_main, NULL)) {
+    pipe.failed = true;
+    fprintf(stderr, "[sm] pipelined compose unavailable; composing on the main thread\n");
+    return false;
+  }
+  fprintf(stderr, "[sm] pipelined compose enabled\n");
+  return true;
+}
+static void pipe_wait_idle_locked(void) {
+  while (pipe.busy) pthread_cond_wait(&pipe.job_done, &pipe.lock);
+}
+static void pipe_reset(void) {
+  if (!pipe.started || pipe.failed) return;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  pipe.completed = pipe.previous = -1;
+  pipe.fresh = false;
+  pthread_mutex_unlock(&pipe.lock);
+}
+void SmRendererPipelineForget(void) { pipe_reset(); }
+void SmRendererPipelineSubmit(SmViewport viewport, bool hud_anchored, const uint32_t *field) {
+  if (!pipe_start()) return;
+  if (pipe.profile < 0) {
+    const char *v = getenv("SNESRECOMP_HOST_PROFILE");
+    pipe.profile = v && *v && *v != '0';
+  }
+  double t0 = pipe.profile ? sm_now() : 0;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  if (pipe.profile) {
+    double w = sm_now() - t0;
+    pipe.stat_wait += w;
+    if (w > pipe.stat_wait_max) pipe.stat_wait_max = w;
+    if (++pipe.stat_jobs == 600) {
+      fprintf(stderr, "[sm pipe] jobs=600 compose_ms/job=%.3f max=%.3f | submit_wait_ms=%.3f max=%.3f\n",
+              pipe.stat_compose * 1e3 / 600, pipe.stat_compose_max * 1e3,
+              pipe.stat_wait * 1e3 / 600, pipe.stat_wait_max * 1e3);
+      pipe.stat_jobs = 0;
+      pipe.stat_compose = pipe.stat_compose_max = pipe.stat_wait = pipe.stat_wait_max = 0;
+    }
+  }
+  if (field) memcpy(pipe.field, field, sizeof(pipe.field));
+  else memset(pipe.field, 0, sizeof(pipe.field));
+  pipe.slot_in = current;
+  pipe.viewport = viewport; pipe.hud = hud_anchored;
+  pipe.previous = pipe.completed;
+  pipe.out_slot = pipe.previous == 0 ? 1u : 0u;
+  pipe.busy = true;
+  pipe.fresh = true;
+  pthread_cond_signal(&pipe.job_ready);
+  pthread_mutex_unlock(&pipe.lock);
+}
+const uint32_t *SmRendererPipelineLatest(int *width) {
+  if (!pipe.started || pipe.failed) return NULL;
+  pthread_mutex_lock(&pipe.lock);
+  int slot;
+  if (pipe.fresh && pipe.previous >= 0) {
+    slot = pipe.previous;            /* exactly frame N-1: no judder */
+  } else {
+    pipe_wait_idle_locked();         /* nothing new captured (pause, menus) */
+    slot = pipe.completed;
+  }
+  pipe.fresh = false;
+  const uint32_t *out = slot >= 0 ? pipe.out[slot] : NULL;
+  if (out && width) *width = pipe.width[slot];
+  pthread_mutex_unlock(&pipe.lock);
+  return out;
+}
+void SmRendererPipelineDrain(void) {
+  if (!pipe.started || pipe.failed) return;
+  pthread_mutex_lock(&pipe.lock);
+  pipe_wait_idle_locked();
+  pthread_mutex_unlock(&pipe.lock);
+}
+#endif
